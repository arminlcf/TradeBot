    },

    "exit_pricing": {
        "price_side": "same",
        "use_order_book": false,
        "order_book_top": 1
    },

    "exchange": {
        "name": "wallex",

        "key": "19838|KANnKDYKOMyoUtfYnOPm7A38sMiOGonZsmy5hhHx",
        "secret": "19838|KANnKDYKOMyoUtfYnOPm7A38sMiOGonZsmy5hhHx",

        "ccxt_config": {
            "enableRateLimit": true,
	    "verbose": true
        },

        "ccxt_async_config": {
